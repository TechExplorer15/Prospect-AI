# Prospect AI Backend — Environment Variables
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/prospect-ai-db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
FRONTEND_URL=https://prospect-ai.vercel.app
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=20
NODE_ENV=development
